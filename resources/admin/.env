# The dev-kit admin, served by "castor dev-kit:serve" with castor-api. Machine-specific values go in .env.local,
# written by "castor dev-kit:init".
APP_ENV=dev
APP_SECRET=
CASTOR_API_URL=http://127.0.0.1:8080
CASTOR_API_TOKEN=
DEV_KIT_STOREFRONT_URL=https://app.test/
DEFAULT_URI=http://127.0.0.1:8091
