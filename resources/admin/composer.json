{
    "name": "app/dev-kit",
    "description": "The dev-kit admin of this project: builds the local Sylius shop from the browser (opencolibri/starter-dev-kit-bundle)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "opencolibri/starter-dev-kit-bundle": "*@dev",
        "sylius/shadcn-admin-ui": "dev-main",
        "sylius/ui-translations": "dev-main",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/stimulus-bundle": "^2.30 || ^3.5",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-icons": "^2.30 || ^3.0",
        "symfony/yaml": "7.4.*",
        "symfonycasts/tailwind-bundle": "^0.13 || ^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
