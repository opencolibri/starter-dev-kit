{
    "name": "opencolibri/starter-dev-kit",
    "description": "Castor tasks of the dev-kit: build the local Sylius shop little by little from a starter.yaml manifest",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sylius",
        "castor",
        "starter"
    ],
    "homepage": "https://github.com/opencolibri/colibri-starter",
    "authors": [
        {
            "name": "Loïc Frémont",
            "email": "lc.fremont@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "opencolibri/starter-core": "self.version",
        "opencolibri/starter-datasets": "self.version",
        "opencolibri/starter-plugins": "self.version",
        "opencolibri/starter-themes": "self.version",
        "symfony/yaml": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "OpenColibri\\Starter\\DevKit\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenColibri\\Starter\\DevKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
